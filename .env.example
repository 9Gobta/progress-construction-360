# Application
APP_ENV=development
APP_NAME=Progress Construction AI
API_V1_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Authentication - replace before any shared deployment
JWT_SECRET_KEY=change-this-to-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Infrastructure
DATABASE_URL=postgresql+psycopg://progress:progress@localhost:5432/progress
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3-compatible object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=progress
S3_SECRET_KEY=change-this-minio-password
S3_BUCKET=progress-construction
S3_REGION=us-east-1
S3_SECURE=false

# Local disk safety. On the current Windows prototype, use C:\ until MinIO is
# moved. After adding an external drive, point both values at that drive.
# STORAGE_GUARD_PATH=C:\
STORAGE_MIN_FREE_GB=50
# PROCESSING_TEMP_DIR=E:\progress-construction-temp
PROCESSING_WORKSPACE_FACTOR=2.0

# Optional external MinIO data location used by infra/compose.yaml.
# Keep unset to continue using the existing Docker named volume.
# MINIO_DATA_PATH=E:/progress-construction-minio

# Optional raw Insta360 X5 support. Point this at the MediaSDK wrapper executable.
# INSTA360_STITCHER_PATH=D:\Insta360SDK\bin\progress-insta360-stitcher.exe
INSTA360_STITCH_TIMEOUT_SECONDS=7200

# Visual localization. The panorama-rig engine is the default for spatially
# correct Virtual Tour portals; Stella remains available for legacy maps.
LOCALIZATION_ENGINE=pycolmap
STELLA_VSLAM_IMAGE=progress-stella-vslam:0.7.0
# STELLA_VSLAM_DOCKER_PATH=D:\DockerDesktop\resources\bin\docker.exe
STELLA_VSLAM_VOCAB_PATH=.runtime/stella/orb_vocab.fbow
STELLA_VSLAM_CONFIG_PATH=infra/stella/x5-equirectangular.yaml
STELLA_VSLAM_TIMEOUT_SECONDS=7200
STELLA_VSLAM_TRACKING_FPS=15
STELLA_VSLAM_FRAME_SKIP=1
# Optional learned cross-day relocalization runtime (recommended).
# HLOC_SOURCE_PATH=E:\project 360\runtime\Hierarchical-Localization
# HLOC_PYTHON_PATH=E:\project 360\runtime\python-packages
# HLOC_TORCH_HOME=E:\project 360\runtime\torch-cache
# HLOC_REFERENCE_CACHE_PATH=E:\project 360\runtime\hloc-reference-maps
HLOC_RETRIEVAL_CANDIDATES=5
HLOC_MIN_GEOMETRIC_INLIERS=24
HLOC_MAX_REFERENCE_IMAGES=96

# Web (copy relevant values to apps/web/.env.local)
API_SERVER_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
